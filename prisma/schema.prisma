datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ApplicationType {
  PARTIAL_MUTATION
  EXPIRED_UPDATE
  EXPIRED_REGULAR
  NEW_TAX_OBJECT
  CORRECTION
  REACTIVATION
  MERGER_MUTATION
  MERGER_AND_PARTIAL_MUTATION
}

enum UserRole {
  FRONT_OFFICER
  VERIFICATOR
  HEAD_OF_ADMINISTRATIVE_OFFICE
  HEAD_OF_OFFICE
  DELIVERY_OFFICER
  CENTRAL_OFFICER
}

enum ApplicationRevision {
  EXTERNAL_REVISION
  INTERNAL_REVISION
}

enum ApplicationStatus {
  VERIFYING
  ADMINISTRATIVE_OFFICE_HEAD_APPROVING
  OFFICE_HEAD_APPROVING
  DELIVERING
  CENTRAL_OFFICE_PROCESSING
  COMPLETED
  EXTERNAL_REVISION
  INTERNAL_REVISION
  EXPIRED
}

enum ApplicationResult {
  APPROVED
  REJECTED
}

enum SubmissionChannel {
  FRONT_OFFICER
  ONLINE_PORTAL
}

enum AuditAction {
  SUBMIT
  CLAIM
  UNCLAIM
  VERIFY_APPROVE
  REQUEST_INTERNAL_REVISION
  REQUEST_EXTERNAL_REVISION
  RESUBMIT_REVISION
  PARAF_ADMINISTRATIVE_HEAD
  SIGN_OFFICE_HEAD
  DISPATCH_DELIVERY
  PROCESS_CENTRAL
  COMPLETE
  NOTIFY_WP
  EXPIRE
  SLA_RECALCULATED
  DUPLICATE
  TOGGLE_FAVORITE
  EDIT
  ASSIGN_BUNDLE
  REMOVE_FROM_BUNDLE
  CREATE_BUNDLE
}

model User {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String        @unique
  passwordHash          String
  role                  UserRole
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  auditLogs             AuditLog[]
  createdBundles        Bundle[]
  submittedApplications Application[] @relation("FrontOfficerApplications")
  verifiedApplications  Application[] @relation("VerificatorApplications")
}

model Application {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  applicationId       String              @unique
  applicationType     ApplicationType

  smartgovId          String?
  smartgovCreatedAt   DateTime?
  smartgovCompletedAt DateTime?

  complementary       ComplementaryData[]
  taxSubject          TaxSubjectData
  taxObject           TaxObjectData

  status              ApplicationStatus   @default(VERIFYING)
  requestedNop        String?             @default("")
  submissionChannel   SubmissionChannel   @default(FRONT_OFFICER)
  isFavorite          Boolean             @default(false)

  sla                 SlaData?
  revisions           Revision[]

  frontOfficerId      String?             @db.ObjectId
  frontOfficer        User?               @relation("FrontOfficerApplications", fields: [frontOfficerId], references: [id])

  verificatorId       String?             @db.ObjectId
  verificator         User?               @relation("VerificatorApplications", fields: [verificatorId], references: [id])

  bundleId            String?             @db.ObjectId
  bundle              Bundle?             @relation(fields: [bundleId], references: [id])

  auditLogs           AuditLog[]

  files               String[]
  resultFiles         String[]
  note                String?

  result              ApplicationResult?
  completedAt         DateTime?
  notifiedToWpAt      DateTime?

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status])
  @@index([verificatorId, status])
  @@index([frontOfficerId, status])
  @@index([smartgovId])
}

model AuditLog {
  id             String             @id @default(auto()) @map("_id") @db.ObjectId

  applicationId  String             @db.ObjectId
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  actorId        String?            @db.ObjectId
  actorName      String?
  actorRole      UserRole?
  actor          User?              @relation(fields: [actorId], references: [id])

  action         AuditAction
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus

  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([applicationId, createdAt])
}

model Bundle {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  bundleId        String           @unique
  applicationType ApplicationType?

  applications    Application[]

  createdById     String?          @db.ObjectId
  createdBy       User?            @relation(fields: [createdById], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Holiday {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  date        DateTime @unique
  type        String
  description String?
  createdAt   DateTime @default(now())
}

type TaxSubjectData {
  name             String?
  whatsappNumber   String?
  address          String?
  block            String?
  neighborhoodUnit String?
  communityUnit    String?
  subdistrict      String?
  village          String?
}

type TaxObjectData {
  nop              String?
  address          String?
  block            String?
  neighborhoodUnit String?
  communityUnit    String?
  subdistrict      String?
  village          String?
  landArea         Float?
  buildingArea     Float?
  certificate      String?
}

type ComplementaryData {
  taxSubjectData TaxSubjectData
  taxObjectData  TaxObjectData
}

type Revision {
  id             String
  type           ApplicationRevision
  reason         String
  fromStatus     ApplicationStatus?
  files          String[]

  authorId       String?             @db.ObjectId
  authorName     String?
  authorRole     UserRole?
  createdAt      DateTime

  resolvedById   String?             @db.ObjectId
  resolvedByName String?
  resolvedAt     DateTime?
}

type SlaData {
  totalStartedAt           DateTime?
  totalDeadline            DateTime?
  overdueAt                DateTime?

  isPaused                 Boolean      @default(false)
  pausedAt                 DateTime?
  pauses                   SlaPause[]

  currentStageStartedAt    DateTime?
  currentStageDeadline     DateTime?
  currentStageMinutesLimit Int?

  stageVisits              StageVisit[]

  externalResubmitCount    Int          @default(0)
  expiresAt                DateTime?
}

type SlaPause {
  from   DateTime
  to     DateTime?
  reason String?
}

type StageVisit {
  stage       ApplicationStatus
  startedAt   DateTime
  completedAt DateTime?
  actorId     String?           @db.ObjectId
  reason      String?
}
